# Execution worker for the live coding lab.
#
# Runs student code off the web process. Daphne serves the whole site from a
# single process, so a five-second blocking subprocess inside a request handler
# is five seconds of somebody else's page not loading.
#
# --concurrency=2 is the real concurrency cap for a room, chosen to match the
# two cores on this box. Raising it past the core count does not add
# throughput; it adds queueing you cannot see.
[Unit]
Description=CCIS CodeHub lab execution worker
After=network.target redis-server.service docker.service
Requires=redis-server.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/CCIS-CodeHub/backend
ExecStart=/home/deploy/CCIS-CodeHub/backend/venv/bin/celery -A core worker \
    --loglevel=info \
    --concurrency=2 \
    --queues=celery \
    --max-tasks-per-child=200 \
    --without-gossip --without-mingle
Restart=always
RestartSec=5
# The worker never runs student code itself — it calls the sandbox over
# loopback — but it is still the process closest to untrusted input.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
